DOMAIN=motorize.agenciatupiniquim.com.br
# Na SiteGround, use mysql. Localmente, sqlite mantém o comportamento anterior.
DB_DRIVER=sqlite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MOTORIZE_ADMIN_USER=admin.motorize
MOTORIZE_OWNER_USER=Tupiniquim_Motorize
MOTORIZE_OWNER_EMAIL=ferramentas@agenciatupiniquim.com.br
# Cadastre MOTORIZE_OWNER_PASSWORD como segredo somente no servidor, nunca no GitHub.
# Alternativa: execute node configure-owner.cjs e digite a senha no terminal.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ferramentas@agenciatupiniquim.com.br
